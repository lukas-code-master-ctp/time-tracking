{
  "name": "@timetracking/extension",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:emulator": "vitest run -c vitest.emulator.config.ts",
    "build": "node scripts/build.ts --mode production",
    "build:dev": "node scripts/build.ts --mode development",
    "build:qa": "node scripts/build.ts --mode qa",
    "dev": "node scripts/build.ts --mode development --watch",
    "smoke": "node scripts/smoke.ts",
    "icons": "node scripts/icons.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.0.0",
    "playwright": "^1.63.0",
    "vite": "^8.3.1"
  }
}
