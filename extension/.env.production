# Build prod (`npm run build -w extension`). Configuración web del proyecto
# Firebase real: Consola de Firebase → Configuración del proyecto → Tus apps →
# app web → "SDK setup and configuration". Estos valores NO son secretos (van
# dentro de la extensión publicada); la seguridad la dan las reglas.
# Reemplaza cada REEMPLAZAR_... (o créalos en `.env.production.local`, que no
# se versiona). Mientras queden placeholders, el build avisa y la extensión
# prod no podrá conectarse.
VITE_FIREBASE_API_KEY=REEMPLAZAR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REEMPLAZAR_PROYECTO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REEMPLAZAR_PROYECTO
VITE_FIREBASE_STORAGE_BUCKET=REEMPLAZAR_PROYECTO.firebasestorage.app
VITE_FIREBASE_APP_ID=REEMPLAZAR_APP_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Cliente OAuth tipo "Extensión de Chrome" (Google Cloud → Credenciales) creado
# con el ID que asigna Chrome Web Store. Va a manifest.json → oauth2 (Tarea 5).
VITE_OAUTH_CLIENT_ID=
# Cliente OAuth "Aplicación web" que Firebase creó para el proveedor Google
# (Google Cloud → Credenciales → "Web client (auto created by Google Service)").
# Lo usa el login de Edge, Brave, Opera, Vivaldi y Arc (launchWebAuthFlow). En
# ese cliente debe estar la redirect URI https://<ID-extensión>.chromiumapp.org/
# (ID de la tienda: egaklokkbnbnccnjicaahaifnkaeobfj). Vacío = esos navegadores
# muestran "Este navegador no es compatible todavía: usa Google Chrome". El
# build QA lo exige. No es secreto (va dentro de la extensión).
VITE_GOOGLE_WEB_CLIENT_ID=
# Opcional: dominios permitidos mostrados en los mensajes, separados por coma
# (por defecto impulseai.cl,compratuparcela.cl). Quien decide es el servidor
# (config/org.allowedDomains o ALLOWED_DOMAIN de functions).
VITE_ALLOWED_DOMAIN=
