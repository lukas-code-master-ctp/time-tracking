# `npm run build -w portal` → portal/dist (Firebase Hosting). Configuración web
# del proyecto Firebase real: Consola de Firebase → Configuración del proyecto →
# Tus apps → app web. Son los mismos valores que extension/.env.production y NO
# son secretos (van en el JavaScript publicado); la seguridad la dan las reglas.
# Reemplaza cada REEMPLAZAR_... (o créalos en `.env.production.local`, que no se
# versiona). Mientras queden placeholders, el build avisa.
VITE_FIREBASE_API_KEY=REEMPLAZAR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REEMPLAZAR_PROYECTO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REEMPLAZAR_PROYECTO
VITE_FIREBASE_STORAGE_BUCKET=REEMPLAZAR_PROYECTO.firebasestorage.app
VITE_FIREBASE_APP_ID=REEMPLAZAR_APP_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Dominio de Google Workspace (se pasa como `hd` al login y valida invitaciones
# mientras no exista config/org). Por defecto compratuparcela.cl.
VITE_ALLOWED_DOMAIN=
# Enlace de instalación de la extensión (Chrome Web Store, no listada) que se
# copia desde Invitaciones. Debe coincidir con EXTENSION_INSTALL_URL de functions.
VITE_EXTENSION_INSTALL_URL=REEMPLAZAR_ENLACE_CHROME_WEB_STORE
