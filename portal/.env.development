# `npm run dev -w portal`: portal contra los emuladores de Firebase del proyecto
# demo `demo-timetracking` (puertos en packages/shared/src/config.ts), con login
# de desarrollo (correo simulado). No hace falta cambiar nada.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-timetracking.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-timetracking
VITE_FIREBASE_STORAGE_BUCKET=demo-timetracking.appspot.com
VITE_FIREBASE_APP_ID=demo-app
VITE_EMULATOR_HOST=127.0.0.1
VITE_ALLOWED_DOMAIN=compratuparcela.cl
VITE_EXTENSION_INSTALL_URL=https://chromewebstore.google.com/detail/dev-extension
