rules_version = '2';

// Security rules (spec section 5).
//
// - All times are integers: epoch milliseconds (see packages/shared/src/types.ts).
// - A caller may write only when `users/{auth.uid}` exists with status 'active'.
// - Admin = users doc with role 'admin' AND status 'active'.
// - `users` docs are created only by Cloud Functions (Admin SDK bypasses rules).
// - Nothing is deleted from clients, except invitations, the general
//   schedule (`config/schedule`, "Eliminar horario") and per-person
//   schedules (`schedules/{uid}`, "Volver al general") by an admin.
// - `breaks` (active breaks, spec 2026-10-21-pausa-activa) are written once
//   by their owner and never changed.
// - `absences` (justified absences, spec 2026-10-22-ausencias-justificadas)
//   are recorded, changed and deleted by an admin. The person reads hers,
//   requests new ones as `pending` and withdraws them while still pending
//   (spec 2026-10-22-solicitud-ausencias); only an admin approves or rejects.
// - `announcements` (spec 2026-11-05-comunicados) are published, archived
//   and deleted by an admin and read by every active person, who confirms
//   the reading once in `announcementReads`.
// - `celebrations/{uid}` (birthdays and work anniversaries, spec
//   2026-11-05-cumpleanos-aniversarios): written by an admin, read by every
//   active person (the extension popup shows the team's).
// - Mood pulse (spec 2026-11-05-pulso-de-animo) is anonymous: `moodWeeks`
//   holds only counters (admins read them); `moodVotes` says which days the
//   person answered, never what (only she reads it). A counter grows by one
//   only in the same write that adds a new day to the person's vote.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && me().status == 'active';
    }

    function isAdmin() {
      return isActive() && me().role == 'admin';
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isNullableInt(v) {
      return v == null || v is int;
    }

    function ownsExisting() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // Client timestamps may not be in the future (tolerates 15 min of clock skew).
    // Past values are allowed: the offline queue uploads late.
    function notFuture(ms) {
      return ms <= request.time.toMillis() + 15 * 60 * 1000;
    }

    function SLOT_MS() {
      return 600000;
    }

    // ---------- config/org ----------

    // One normalized domain: lowercase, without '@' (e.g. 'impulseai.cl').
    // Same shape as DOMAIN_RE in packages/shared/src/domain.ts (no empty
    // labels like 'a..cl', no label starting or ending with '-').
    function validDomain(x) {
      return x is string && x.size() >= 4 && x.size() <= 253
        && x.matches('([a-z0-9]([a-z0-9-]*[a-z0-9])?[.])+[a-z]{2,63}');
    }

    // Element i of the list is valid (or the list is shorter). Rules have no
    // loops, so the 10 possible positions are checked one by one.
    function validDomainAt(list, i) {
      return list.size() <= i || validDomain(list[i]);
    }

    // 1–10 valid, unique domains.
    function validDomainList(list) {
      return list is list && list.size() >= 1 && list.size() <= 10
        && list.toSet().size() == list.size()
        && validDomainAt(list, 0) && validDomainAt(list, 1) && validDomainAt(list, 2)
        && validDomainAt(list, 3) && validDomainAt(list, 4) && validDomainAt(list, 5)
        && validDomainAt(list, 6) && validDomainAt(list, 7) && validDomainAt(list, 8)
        && validDomainAt(list, 9);
    }

    function validOrgConfig(d) {
      return d.keys().hasOnly(['allowedDomains', 'screenshotsEnabled', 'blurScreenshots',
                                'screenshotRetentionDays', 'pauseTimerAtLunch',
                                'activeBreaksEnabled', 'activeBreakMode',
                                'activeBreakIntervalMinutes', 'activeBreaksPerDay',
                                'activeBreakMinutes', 'moodPulseEnabled', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['allowedDomains', 'screenshotsEnabled', 'blurScreenshots',
                            'screenshotRetentionDays', 'updatedAt', 'updatedBy'])
        && validDomainList(d.allowedDomains)
        // The admin cannot leave out the domain of their own account (joinOrg
        // would then reject them at the next login).
        && me().email.lower().split('@')[1] in d.allowedDomains
        && d.screenshotsEnabled is bool
        && d.blurScreenshots is bool
        // Optional (older documents don't have it).
        && (!('pauseTimerAtLunch' in d) || d.pauseTimerAtLunch is bool)
        // Active breaks (optional; bounds of packages/shared/src/breaks.ts).
        && (!('activeBreaksEnabled' in d) || d.activeBreaksEnabled is bool)
        && (!('activeBreakIntervalMinutes' in d)
            || (d.activeBreakIntervalMinutes is int
                && d.activeBreakIntervalMinutes >= 15 && d.activeBreakIntervalMinutes <= 240))
        && (!('activeBreakMode' in d) || d.activeBreakMode in ['interval', 'daily'])
        && (!('activeBreaksPerDay' in d)
            || (d.activeBreaksPerDay is int
                && d.activeBreaksPerDay >= 1 && d.activeBreaksPerDay <= 12))
        && (!('activeBreakMinutes' in d)
            || (d.activeBreakMinutes is int
                && d.activeBreakMinutes >= 1 && d.activeBreakMinutes <= 15))
        // Mood pulse (optional; spec 2026-11-05-pulso-de-animo).
        && (!('moodPulseEnabled' in d) || d.moodPulseEnabled is bool)
        && d.screenshotRetentionDays is int
        && d.screenshotRetentionDays >= 1 && d.screenshotRetentionDays <= 3650
        && d.updatedAt is int
        && d.updatedBy == request.auth.uid;
    }

    // ---------- working hours (spec 2026-09-30-horarios.md) ----------
    //
    // Same shape as packages/shared/src/schedule.ts (validateScheduleConfig).
    // `HH:MM` strings sort like the times they represent, so the order of the
    // hours is checked by comparing strings.

    // 'HH:MM', 00:00–23:59 (TIME_RE in schedule.ts).
    function validTime(t) {
      return t is string && t.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
    }

    // null = day off. Otherwise start < end (no midnight crossing) and the
    // lunch is both null or both set inside [start, end].
    function validDay(d) {
      return d == null
        || (d is map
          && d.keys().hasOnly(['start', 'end', 'lunchStart', 'lunchEnd'])
          && d.keys().hasAll(['start', 'end', 'lunchStart', 'lunchEnd'])
          && validTime(d.start) && validTime(d.end) && d.start < d.end
          && ((d.lunchStart == null && d.lunchEnd == null)
              || (validTime(d.lunchStart) && validTime(d.lunchEnd)
                  && d.start <= d.lunchStart && d.lunchStart < d.lunchEnd
                  && d.lunchEnd <= d.end)));
    }

    function validWeek(w) {
      return w is map
        && w.keys().hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
        && w.keys().hasAll(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
        && validDay(w.mon) && validDay(w.tue) && validDay(w.wed) && validDay(w.thu)
        && validDay(w.fri) && validDay(w.sat) && validDay(w.sun);
    }

    // 0–60 unique 'YYYY-MM-DD' strings. Rules have no loops: the list is
    // joined with ',' and matched as a whole. join() fails (denies) on
    // non-strings, and the length 11·n − 1 means exactly n dates, so no item
    // can smuggle a ',' (the calendar validity, e.g. no Feb 30, is checked by
    // the client and the pure functions).
    function validHolidays(list) {
      return list is list && list.size() <= 60
        && list.toSet().size() == list.size()
        && (list.size() == 0
            || (list.join(',').size() == 11 * list.size() - 1
                && list.join(',').matches(
                  '[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(,[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))*')));
    }

    function validScheduleConfig(d) {
      return d.keys().hasOnly(['week', 'holidays', 'toleranceMinutes', 'remindersEnabled',
                                'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['week', 'holidays', 'toleranceMinutes', 'remindersEnabled',
                            'updatedAt', 'updatedBy'])
        && validWeek(d.week)
        && validHolidays(d.holidays)
        && d.toleranceMinutes is int
        && d.toleranceMinutes >= 0 && d.toleranceMinutes <= 60
        && d.remindersEnabled is bool
        && d.updatedAt is int
        && d.updatedBy == request.auth.uid;
    }

    function validPersonSchedule(d) {
      return d.keys().hasOnly(['week', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['week', 'updatedAt', 'updatedBy'])
        && validWeek(d.week)
        && d.updatedAt is int
        && d.updatedBy == request.auth.uid;
    }

    // config/org and config/schedule: any active user reads them (the
    // extension needs both); only an active admin writes them.
    match /config/{docId} {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && ((docId == 'org' && validOrgConfig(incoming()))
            || (docId == 'schedule' && validScheduleConfig(incoming())));
      // An admin may delete the general schedule ("Eliminar horario" in the
      // portal): without it everything works as before the schedules (the
      // extension measures whenever the work day is open). config/org is
      // never deleted.
      allow delete: if isAdmin() && docId == 'schedule';
    }

    // ---------- schedules/{uid} (per-person exception) ----------

    match /schedules/{uid} {
      allow get: if isAdmin() || (isSelf(uid) && isActive());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && exists(userPath(uid))
        && validPersonSchedule(incoming());
      // "Volver al general".
      allow delete: if isAdmin();
    }

    // ---------- invitations/{emailLower} ----------

    function validInvitation(d, emailId) {
      return d.keys().hasOnly(['email', 'invitedBy', 'invitedAt', 'status', 'acceptedAt'])
        && d.keys().hasAll(['email', 'invitedBy', 'invitedAt', 'status'])
        && d.email is string
        && d.email.trim().lower() == emailId
        && d.invitedBy is string
        && d.invitedAt is int
        && d.status in ['pending', 'accepted', 'revoked']
        && (!('acceptedAt' in d) || d.acceptedAt is int);
    }

    match /invitations/{emailId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validInvitation(incoming(), emailId)
        && incoming().status == 'pending'
        && incoming().invitedBy == request.auth.uid;
      allow update: if isAdmin()
        && validInvitation(incoming(), emailId)
        && incoming().email == resource.data.email
        // Re-inviting records the caller; nobody attributes it to someone else.
        && (incoming().invitedBy == resource.data.invitedBy
            || incoming().invitedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---------- users/{uid} ----------

    match /users/{uid} {
      // Own doc is readable even when disabled or missing (the extension needs
      // to know it has no access yet).
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      // Created only by the `joinOrg` Cloud Function.
      allow create: if false;

      allow update: if
        // Collaborator: only the consent fields of their own doc.
        (isSelf(uid) && isActive()
          && changedKeys().hasOnly(['consentAcceptedAt', 'consentVersion'])
          && incoming().consentAcceptedAt is int
          && incoming().consentVersion is string
          && incoming().consentVersion.size() > 0)
        ||
        // Admin: role/status of other users (never their own, to avoid lock-out).
        (isAdmin() && !isSelf(uid)
          && changedKeys().hasOnly(['role', 'status'])
          && incoming().role in ['admin', 'member']
          && incoming().status in ['active', 'disabled']);

      allow delete: if false;
    }

    // ---------- sessions/{sessionId} ----------

    // Kiosk sessions (spec 2026-11-10-marcaciones) also carry source,
    // kioskId and closedByKioskId, written only by kioskPunch: the person
    // never creates them (create below allows only the 5 base fields) and an
    // update never changes them (changedKeys), so the extension can heartbeat
    // and close a kiosk work day it joined.
    function validSessionFields(d) {
      return d.keys().hasOnly(['uid', 'startedAt', 'endedAt', 'endReason', 'lastHeartbeatAt',
                               'source', 'kioskId', 'closedByKioskId'])
        && d.keys().hasAll(['uid', 'startedAt', 'endedAt', 'endReason', 'lastHeartbeatAt'])
        && d.uid is string
        && d.startedAt is int
        && isNullableInt(d.endedAt)
        && (d.endReason == null || d.endReason in ['manual', 'auto'])
        && d.lastHeartbeatAt is int
        // Open <=> no endReason; closed => endReason set and endedAt coherent.
        && ((d.endedAt == null) == (d.endReason == null))
        && d.startedAt >= 0 && notFuture(d.startedAt)
        && d.lastHeartbeatAt >= d.startedAt && notFuture(d.lastHeartbeatAt)
        && (d.endedAt == null || (d.endedAt >= d.startedAt && notFuture(d.endedAt)));
    }

    // Spec 2026-11-10-marcaciones: a person who marks only on the kiosk
    // cannot open a work day from the extension (kiosk sessions are written
    // by the `kioskPunch` Cloud Function, which bypasses these rules).
    function kioskOnly() {
      let p = /databases/$(database)/documents/attendanceSettings/$(request.auth.uid);
      return exists(p) && get(p).data.mode == 'kiosk';
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin() || ownsExisting();

      allow create: if isActive()
        && !kioskOnly()
        && incoming().keys().hasOnly(['uid', 'startedAt', 'endedAt', 'endReason', 'lastHeartbeatAt'])
        && validSessionFields(incoming())
        && incoming().uid == request.auth.uid
        && incoming().endedAt == null
        && incoming().endReason == null;

      // Only open sessions change (heartbeat / close). A closed session
      // (manually or by autoCloseStaleSessions) is immutable, so hours cannot
      // be rewritten nor a session reopened.
      allow update: if isActive()
        && ownsExisting()
        && resource.data.endedAt == null
        && validSessionFields(incoming())
        && changedKeys().hasOnly(['lastHeartbeatAt', 'endedAt', 'endReason']);

      allow delete: if false;
    }

    // ---------- activity/{uid_slotStartMs} ----------

    // meetingSeconds (spec 2026-09-30, "En reunión") is optional: extension
    // 0.1.1 and older documents do not carry it.
    function validMeetingSeconds(d) {
      return !d.keys().hasAny(['meetingSeconds'])
        || (d.meetingSeconds is int && d.meetingSeconds >= 0
            && d.meetingSeconds + d.activeSeconds <= d.trackedSeconds);
    }

    function validActivity(d, docId) {
      return d.keys().hasOnly(['uid', 'sessionId', 'slotStart', 'trackedSeconds', 'activeSeconds',
                                'outsideChromeSeconds', 'domains', 'urls', 'meetingSeconds'])
        && d.keys().hasAll(['uid', 'sessionId', 'slotStart', 'trackedSeconds', 'activeSeconds',
                            'outsideChromeSeconds', 'domains', 'urls'])
        && d.uid == request.auth.uid
        && d.sessionId is string && d.sessionId.size() > 0
        && d.slotStart is int && d.slotStart >= 0
        && d.slotStart % SLOT_MS() == 0 && notFuture(d.slotStart)
        && docId == d.uid + '_' + string(d.slotStart)
        && d.trackedSeconds is number
        && d.trackedSeconds >= 0 && d.trackedSeconds <= 600
        && d.activeSeconds is number
        && d.activeSeconds >= 0 && d.activeSeconds <= d.trackedSeconds
        && d.outsideChromeSeconds is number
        && d.outsideChromeSeconds >= 0 && d.outsideChromeSeconds <= d.trackedSeconds
        && d.domains is map
        && d.urls is list && d.urls.size() <= 20
        && validMeetingSeconds(d);
    }

    match /activity/{docId} {
      allow read: if isAdmin() || ownsExisting();

      allow create: if isActive() && validActivity(incoming(), docId);

      allow update: if isActive()
        && ownsExisting()
        && validActivity(incoming(), docId);

      allow delete: if false;
    }

    // ---------- screenshots/{id} ----------

    function validScreenshot(d) {
      return d.keys().hasOnly(['uid', 'sessionId', 'takenAt', 'storagePath', 'blurred',
                                'width', 'height'])
        && d.keys().hasAll(['uid', 'sessionId', 'takenAt', 'storagePath', 'blurred',
                            'width', 'height'])
        && d.uid == request.auth.uid
        && d.sessionId is string && d.sessionId.size() > 0
        && d.takenAt is int && d.takenAt >= 0 && notFuture(d.takenAt)
        && d.storagePath is string
        && d.storagePath.matches('screenshots/' + d.uid + '/[0-9]{4}-[0-9]{2}-[0-9]{2}/[^/]+[.]jpg')
        && d.blurred is bool
        && d.width is int && d.width > 0
        && d.height is int && d.height > 0;
    }

    match /screenshots/{id} {
      allow read: if isAdmin() || ownsExisting();

      allow create: if isActive() && validScreenshot(incoming());

      // Re-uploading the same metadata (offline queue retry) is allowed, but
      // existing metadata cannot be altered (no swapping storagePath/takenAt).
      allow update: if isActive()
        && ownsExisting()
        && validScreenshot(incoming())
        && changedKeys().size() == 0;

      allow delete: if false;
    }

    // ---------- breaks/{uid_promptedAt} (active breaks) ----------

    // One answer per reminder. `taken`: the break [start, end] lasts at most
    // 15 min and starts after the reminder; otherwise start = end = answeredAt.
    function validBreak(d, docId) {
      return d.keys().hasOnly(['uid', 'sessionId', 'status', 'promptedAt', 'answeredAt',
                                'start', 'end', 'exercise'])
        && d.keys().hasAll(['uid', 'sessionId', 'status', 'promptedAt', 'answeredAt',
                            'start', 'end', 'exercise'])
        && d.uid == request.auth.uid
        && d.sessionId is string && d.sessionId.size() > 0 && d.sessionId.size() <= 64
        && d.status in ['taken', 'postponed', 'skipped']
        && d.promptedAt is int && d.promptedAt >= 0 && notFuture(d.promptedAt)
        && docId == d.uid + '_' + string(d.promptedAt)
        && d.answeredAt is int && d.answeredAt >= d.promptedAt && notFuture(d.answeredAt)
        && d.start is int && d.end is int
        && d.start >= d.promptedAt && d.end >= d.start
        && d.end - d.start <= 15 * 60 * 1000 && notFuture(d.end)
        && (d.status == 'taken' || (d.start == d.answeredAt && d.end == d.answeredAt))
        && d.exercise is string && d.exercise.size() <= 40;
    }

    match /breaks/{docId} {
      allow read: if isAdmin() || ownsExisting();

      allow create: if isActive() && validBreak(incoming(), docId);

      // Re-uploading the same answer (offline queue retry) is allowed; it
      // cannot be changed afterwards.
      allow update: if isActive()
        && ownsExisting()
        && validBreak(incoming(), docId)
        && changedKeys().size() == 0;

      allow delete: if false;
    }

    // ---------- absences/{id} (justified absences) ----------

    // 'YYYY-MM-DD' (the calendar validity, e.g. no Feb 30, is checked by the
    // portal and packages/shared/src/absences.ts).
    function validDateKey(d) {
      return d is string && d.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }

    // Whole days: both times null. By hours: one day and start < end.
    // At most 366 days (compared through timestamps of the dates).
    function validAbsence(d) {
      return d.keys().hasOnly(['uid', 'type', 'startDate', 'endDate', 'startTime', 'endTime', 'note',
                                'status', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['uid', 'type', 'startDate', 'endDate', 'startTime', 'endTime', 'note',
                            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.uid is string && exists(userPath(d.uid))
        && d.type in ['vacation', 'medical', 'errand', 'permission', 'other']
        && validDateKey(d.startDate) && validDateKey(d.endDate)
        && d.startDate <= d.endDate
        && timestamp.date(int(d.endDate.split('-')[0]), int(d.endDate.split('-')[1]), int(d.endDate.split('-')[2]))
           < timestamp.date(int(d.startDate.split('-')[0]), int(d.startDate.split('-')[1]), int(d.startDate.split('-')[2]))
             + duration.value(366, 'd')
        && ((d.startTime == null && d.endTime == null)
            || (validTime(d.startTime) && validTime(d.endTime) && d.startTime < d.endTime
                && d.startDate == d.endDate))
        && d.note is string && d.note.size() <= 500
        && (d.type != 'other' || d.note.trim().size() > 0)
        // Optional: documents recorded before the requests have none (= approved).
        && (!('status' in d) || d.status in ['pending', 'approved', 'rejected'])
        && d.createdAt is int && d.createdBy is string
        && d.updatedAt is int
        && d.updatedBy == request.auth.uid;
    }

    match /absences/{id} {
      allow read: if isAdmin() || (isActive() && ownsExisting());
      allow create: if (isAdmin()
          && validAbsence(incoming())
          && incoming().createdBy == request.auth.uid)
        // The person's own request from the extension: pending, by and for herself.
        || (isActive()
          && validAbsence(incoming())
          && incoming().uid == request.auth.uid
          && incoming().createdBy == request.auth.uid
          && incoming().status == 'pending'
          && notFuture(incoming().createdAt)
          && incoming().updatedAt == incoming().createdAt);
      // The person and the creation stay; the rest may change.
      allow update: if isAdmin()
        && validAbsence(incoming())
        && incoming().uid == resource.data.uid
        && incoming().createdAt == resource.data.createdAt
        && incoming().createdBy == resource.data.createdBy;
      // The person withdraws her own request while it is still pending.
      allow delete: if isAdmin()
        || (isActive() && ownsExisting() && resource.data.get('status', 'approved') == 'pending');
    }

    // ---------- announcements (spec 2026-11-05-comunicados) ----------

    // Same limits as packages/shared/src/announcements.ts.
    function validAnnouncement(d) {
      return d.keys().hasOnly(['title', 'body', 'authorName', 'createdAt', 'createdBy', 'archivedAt'])
        && d.keys().hasAll(['title', 'body', 'authorName', 'createdAt', 'createdBy', 'archivedAt'])
        && d.title is string && d.title.trim().size() > 0 && d.title.size() <= 120
        && d.body is string && d.body.trim().size() > 0 && d.body.size() <= 4000
        && d.authorName is string && d.authorName.trim().size() > 0 && d.authorName.size() <= 80
        && d.createdAt is int && d.createdBy is string
        && isNullableInt(d.archivedAt);
    }

    // Every active person reads them (the extension shows them); an admin
    // publishes, archives/unarchives (nothing else changes) and deletes.
    match /announcements/{id} {
      allow read: if isActive();
      allow create: if isAdmin()
        && validAnnouncement(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().archivedAt == null
        && notFuture(incoming().createdAt);
      allow update: if isAdmin()
        && validAnnouncement(incoming())
        && changedKeys().hasOnly(['archivedAt']);
      allow delete: if isAdmin();
    }

    function validAnnouncementRead(d, docId) {
      return d.keys().hasOnly(['announcementId', 'uid', 'readAt'])
        && d.keys().hasAll(['announcementId', 'uid', 'readAt'])
        && d.uid == request.auth.uid
        && d.announcementId is string && d.announcementId.size() > 0
        && docId == d.announcementId + '_' + d.uid
        && d.readAt is int && d.readAt >= 0 && notFuture(d.readAt);
    }

    // "Confirmo que lo leí": written once by the person, never changed.
    match /announcementReads/{docId} {
      allow read: if isAdmin() || (isActive() && ownsExisting());
      allow create: if isActive()
        && validAnnouncementRead(incoming(), docId)
        && exists(/databases/$(database)/documents/announcements/$(incoming().announcementId));
      // Re-sending the same confirmation is allowed; it cannot be changed.
      allow update: if isActive()
        && ownsExisting()
        && validAnnouncementRead(incoming(), docId)
        && changedKeys().size() == 0;
      allow delete: if false;
    }

    // ---------- celebrations/{uid} (birthdays and work anniversaries) ----------

    // 'MM-DD' (Feb 29 allowed; the calendar validity is checked by the
    // portal and packages/shared/src/celebrations.ts).
    function validMonthDay(d) {
      return d is string && d.matches('(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }

    function validCelebration(d, uid) {
      return d.keys().hasOnly(['displayName', 'birthday', 'hireDate', 'active', 'managerUid', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['displayName', 'birthday', 'hireDate', 'active', 'updatedAt', 'updatedBy'])
        && d.displayName is string && d.displayName.size() <= 200
        && (d.birthday == null || validMonthDay(d.birthday))
        && (d.hireDate == null || validDateKey(d.hireDate))
        && d.active is bool
        // Optional (documents before the bosses have none).
        && (!('managerUid' in d) || d.managerUid == null
            || (d.managerUid is string && d.managerUid != uid && exists(userPath(d.managerUid))))
        && d.updatedAt is int
        && d.updatedBy == request.auth.uid;
    }

    match /celebrations/{uid} {
      // Birthday (day and month, no year) and hire date of the team: every
      // active person reads them for the popup.
      allow read: if isActive();
      allow create, update: if isAdmin() && exists(userPath(uid)) && validCelebration(incoming(), uid);
      allow delete: if isAdmin();
    }

    // ---------- mood pulse (spec 2026-11-05-pulso-de-animo) ----------

    // ISO week 'YYYY-Www' (isValidWeekKey in packages/shared/src/mood.ts).
    function validWeekKey(w) {
      return w is string && w.matches('[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])');
    }

    // 1–7 unique 'YYYY-MM-DD' strings (same technique as validHolidays).
    function validVoteDates(list) {
      return list is list && list.size() >= 1 && list.size() <= 7
        && list.toSet().size() == list.size()
        && list.join(',').size() == 11 * list.size() - 1
        && list.join(',').matches(
          '[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(,[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))*');
    }

    function votePath(week) {
      return /databases/$(database)/documents/moodVotes/$(request.auth.uid + '_' + week);
    }

    // This write adds exactly one day to the caller's vote of `week`.
    function addsOneVote(week) {
      return existsAfter(votePath(week))
        && ((!exists(votePath(week)) && getAfter(votePath(week)).data.dates.size() == 1)
            || (exists(votePath(week))
                && getAfter(votePath(week)).data.dates.size() == get(votePath(week)).data.dates.size() + 1));
    }

    function count(d, k) {
      return d.get(k, 0);
    }

    // Counter k stays or grows by one.
    function sameOrPlusOne(k) {
      return incoming().get(k, 0) is int
        && (count(incoming(), k) == count(resource.data, k)
            || count(incoming(), k) == count(resource.data, k) + 1);
    }

    function validMoodKeys(d) {
      return d.keys().hasOnly(['n1', 'n2', 'n3', 'n4', 'n5']);
    }

    match /moodWeeks/{week} {
      allow read: if isAdmin();
      // First answer of the week: one counter at 1.
      allow create: if isActive() && validWeekKey(week)
        && validMoodKeys(incoming()) && incoming().keys().size() == 1
        && incoming()[incoming().keys()[0]] == 1
        && addsOneVote(week);
      // Exactly one counter grows by one.
      allow update: if isActive() && validWeekKey(week)
        && validMoodKeys(incoming())
        && changedKeys().size() == 1
        && sameOrPlusOne('n1') && sameOrPlusOne('n2') && sameOrPlusOne('n3')
        && sameOrPlusOne('n4') && sameOrPlusOne('n5')
        && addsOneVote(week);
      allow delete: if false;
    }

    function validMoodVote(d, docId) {
      return d.keys().hasOnly(['uid', 'week', 'dates'])
        && d.keys().hasAll(['uid', 'week', 'dates'])
        && d.uid == request.auth.uid
        && validWeekKey(d.week)
        && docId == d.uid + '_' + d.week
        && validVoteDates(d.dates);
    }

    match /moodVotes/{docId} {
      // Nobody else, not even an admin: it would tell who answered.
      allow get: if isActive() && ownsExisting();
      allow list: if false;
      allow create: if isActive() && validMoodVote(incoming(), docId)
        && incoming().dates.size() == 1;
      // Only new days are added.
      allow update: if isActive() && ownsExisting()
        && validMoodVote(incoming(), docId)
        && changedKeys().hasOnly(['dates'])
        && incoming().dates.size() == resource.data.dates.size() + 1
        && incoming().dates.hasAll(resource.data.dates);
      allow delete: if false;
    }

    // ---------- attendance marks (spec 2026-11-10-marcaciones) ----------

    // Normalized RUT '12345678-K' (normalizeRut in packages/shared/src/attendance.ts
    // also checks the check digit).
    function validRut(r) {
      return r is string && r.matches('[1-9][0-9]{0,7}-[0-9K]');
    }

    function validAttendanceSettings(d) {
      return d.keys().hasOnly(['rut', 'mode', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['rut', 'mode', 'updatedAt', 'updatedBy'])
        && (d.rut == null || validRut(d.rut))
        && d.mode in ['extension', 'kiosk', 'both']
        && d.updatedAt is int
        && d.updatedBy == request.auth.uid;
    }

    match /attendanceSettings/{uid} {
      // The extension reads its own mode; the RUT lookup of the kiosk runs
      // in the `kioskPunch` Cloud Function (Admin SDK).
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && exists(userPath(uid)) && validAttendanceSettings(incoming());
      allow delete: if isAdmin();
    }

    // `kiosks/{sha256 of the token}`: the token stays on the device.
    function validKiosk(d) {
      return d.keys().hasOnly(['name', 'createdAt', 'createdBy', 'revokedAt', 'lastUsedAt'])
        && d.keys().hasAll(['name', 'createdAt', 'createdBy', 'revokedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.createdAt is int
        && isNullableInt(d.revokedAt)
        && (!('lastUsedAt' in d) || isNullableInt(d.lastUsedAt));
    }

    match /kiosks/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && id.matches('[0-9a-f]{64}')
        && validKiosk(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().revokedAt == null
        && !('lastUsedAt' in incoming());
      // Revoke (or rename): never brought back with the same token.
      allow update: if isAdmin() && validKiosk(incoming())
        && changedKeys().hasOnly(['name', 'revokedAt'])
        && (resource.data.revokedAt == null || incoming().revokedAt == resource.data.revokedAt);
      allow delete: if isAdmin();
    }

    // Anything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
