# Copy to `functions/.secret.local` to give the emulator the Resend key (the
# file is git-ignored). Even with it, the emulator never sends:
# FUNCTIONS_EMULATOR=true forces log-only mode. The secret is only declared
# with EMAIL_ENABLED=true (functions/.env.*).
# In production set it with: npx firebase functions:secrets:set RESEND_API_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
