# Copy to `functions/.secret.local` to test real SMTP delivery in the emulator
# (the file is git-ignored). Without it, the emulator warns that the secrets
# are missing and `onInvitationWritten` only logs the email. Even with it,
# the emulator never sends: FUNCTIONS_EMULATOR=true forces log-only mode.
# The secrets are only declared with INVITE_EMAIL_ENABLED=true (functions/.env.*).
# In production set them with: npx firebase functions:secrets:set SMTP_HOST (etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=notificaciones@compratuparcela.cl
SMTP_PASS=contraseña-de-aplicacion
SMTP_FROM="Registro de jornada <notificaciones@compratuparcela.cl>"
