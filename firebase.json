{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules", ".git", "*.log", "src", "test", "build.mjs", "tsconfig.json",
        "vitest.config.ts", "vitest.emulator.config.ts", ".secret.local*"
      ],
      "predeploy": ["npm run build:functions"]
    }
  ],
  "hosting": {
    "public": "portal/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "hosting": { "host": "127.0.0.1", "port": 5000 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 }
  }
}
